{
  "architecture": {
    "components": [
      {
        "name": "handlers",
        "paths": ["**/handlers", "**/handlers/**"]
      },
      {
        "name": "domain",
        "paths": ["**/domain", "**/domain/**"]
      },
      {
        "name": "infra",
        "paths": ["**/infra", "**/infra/**"]
      }
    ],
    "dependency_rules": [
      {
        "component": "handlers",
        "may_depend_on": ["handlers", "domain"]
      },
      {
        "component": "domain",
        "may_depend_on": ["domain"]
      }
    ],
    "content_rules": [
      {
        "component": "domain",
        "allowed_kinds": ["struct"]
      }
    ],
    "naming_rules": [
      {
        "component": "infra",
        "kind": "struct",
        "pattern": "^.*(Repository|Client)$"
      }
    ]
  },
  "checks": [
    {
      "name": "dogfood-component-deps",
      "architecture_checker": "component-deps",
      "severity": "advisory",
      "scope": ["testdata/dogfood-architecture/**"],
      "triggers": ["batch"]
    },
    {
      "name": "dogfood-content-rules",
      "architecture_checker": "content-rules",
      "severity": "advisory",
      "scope": ["testdata/dogfood-architecture/**"],
      "triggers": ["batch"]
    },
    {
      "name": "dogfood-naming-rules",
      "architecture_checker": "naming-rules",
      "severity": "advisory",
      "scope": ["testdata/dogfood-architecture/**"],
      "triggers": ["batch"]
    },
    {
      "name": "markdown-link-integrity",
      "checker": "markdown-link-integrity",
      "severity": "blocking",
      "scope": ["**/*.md"],
      "triggers": ["PostToolUse", "batch"],
      "message": "broken markdown link/anchor"
    },
    {
      "name": "primitive-obsession",
      "checker": "primitive-obsession",
      "severity": "advisory",
      "scope": ["**/*.go"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "duplicate-code",
      "checker": "duplicate-code",
      "severity": "advisory",
      "scope": ["**/*.go", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.py", "**/*.java", "**/*.kt"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "go-blank-imports",
      "checker": "go-blank-imports",
      "severity": "advisory",
      "scope": ["**/*.go"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "go-ignored-error",
      "checker": "go-ignored-error",
      "severity": "advisory",
      "scope": ["**/*.go"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "go-error-context",
      "checker": "go-error-context",
      "severity": "advisory",
      "scope": ["**/*.go"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "syntax-rules-go",
      "checker": "syntax-rules",
      "severity": "advisory",
      "scope": ["**/*.go"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "syntax-rules-typescript",
      "checker": "syntax-rules-typescript",
      "severity": "advisory",
      "scope": ["**/*.ts"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "syntax-rules-tsx",
      "checker": "syntax-rules-tsx",
      "severity": "advisory",
      "scope": ["**/*.tsx"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "syntax-rules-javascript",
      "checker": "syntax-rules-javascript",
      "severity": "advisory",
      "scope": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "syntax-rules-python",
      "checker": "syntax-rules-python",
      "severity": "advisory",
      "scope": ["**/*.py"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "syntax-rules-java",
      "checker": "syntax-rules-java",
      "severity": "advisory",
      "scope": ["**/*.java"],
      "triggers": ["PostToolUse", "batch"]
    },
    {
      "name": "syntax-rules-kotlin",
      "checker": "syntax-rules-kotlin",
      "severity": "advisory",
      "scope": ["**/*.kt", "**/*.kts"],
      "triggers": ["PostToolUse", "batch"]
    }
  ]
}
